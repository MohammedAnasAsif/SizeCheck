{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/MohammedAnasAsif/SizeCheck/data/schema/brand.schema.json",
  "title": "SizeCheck brand size charts",
  "description": "One file per brand in data/brands/. Values are copied from the brand's own official size chart, in the unit the brand published.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "origin", "aliases", "charts"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Lowercase slug. Must match the file name (zara.json -> zara)."
    },
    "name": { "type": "string", "minLength": 1 },
    "origin": { "enum": ["indian", "international"] },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9]+( [a-z0-9]+)*$" },
      "description": "Lowercase names as they appear in shop links, words separated by single spaces (e.g. \"van heusen\", \"us polo assn\")."
    },
    "domains": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$" },
      "description": "The brand's own shop domains, without www."
    },
    "charts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/chart" }
    }
  },
  "definitions": {
    "value": {
      "description": "A single number, or [min, max].",
      "oneOf": [
        { "type": "number", "exclusiveMinimum": 0 },
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        }
      ]
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "minProperties": 2,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "alt": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Other names for the same size, e.g. [\"40\"] for M."
        },
        "chest": { "$ref": "#/definitions/value" },
        "waist": { "$ref": "#/definitions/value" },
        "hip": { "$ref": "#/definitions/value" },
        "shoulder": { "$ref": "#/definitions/value" },
        "neck": { "$ref": "#/definitions/value" },
        "sleeve": { "$ref": "#/definitions/value" },
        "inseam": { "$ref": "#/definitions/value" },
        "height": { "$ref": "#/definitions/value" },
        "foot": { "$ref": "#/definitions/value" }
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "basis", "unit", "sizes", "source"],
      "properties": {
        "category": {
          "enum": [
            "men_tops",
            "men_shirts",
            "men_bottoms",
            "women_tops",
            "women_bottoms",
            "women_dresses",
            "unisex_tops",
            "unisex_bottoms",
            "men_footwear",
            "women_footwear"
          ]
        },
        "basis": {
          "enum": ["body", "garment"],
          "description": "body = the chart lists body measurements. garment = it lists measurements of the clothing itself."
        },
        "fit": { "enum": ["slim", "regular", "relaxed"] },
        "region": {
          "type": "string",
          "description": "Which market the chart is for, e.g. IN, EU, INTL."
        },
        "unit": { "enum": ["cm", "in"] },
        "note": { "type": "string" },
        "sizes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/definitions/size" }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "verified_on"],
          "properties": {
            "url": { "type": "string", "pattern": "^https://" },
            "verified_on": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "by": { "type": "string" }
          }
        }
      }
    }
  }
}
